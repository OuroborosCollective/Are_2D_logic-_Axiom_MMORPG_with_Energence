---
import DefaultLayout from '../layouts/default.astro';
---

<script src="../src/main"></script>

<DefaultLayout title="AreAxiomian Admin — Thosu Only">
    <!-- LOGIN SCREEN -->
    <div id="login-screen" style="display:flex; justify-content:center; align-items:center; min-height:100vh;">
        <div class="card" style="width:380px; text-align:center;">
            <h2 style="margin-bottom:8px;">🔒 AreAxiomian Admin</h2>
            <p class="text-muted" style="margin-bottom:20px;">Exclusive access — Thosu only</p>
            <div id="login-error" style="display:none; color:var(--danger); margin-bottom:12px; font-size:14px;"></div>
            <input id="login-user" type="text" placeholder="Username" style="margin-bottom:8px;" autocomplete="off" />
            <input id="login-pass" type="password" placeholder="Password" style="margin-bottom:16px;" />
            <button id="login-btn" style="width:100%;">Login</button>
        </div>
    </div>

    <!-- ADMIN DASHBOARD (hidden until authenticated) -->
    <div id="admin-app" style="display:none;">
        <!-- Sidebar -->
        <nav id="sidebar" style="position:fixed; top:0; left:0; width:220px; height:100vh; background:var(--surface); border-right:1px solid var(--border); padding:16px; overflow-y:auto; z-index:100;">
            <h2 style="font-size:18px; margin-bottom:4px;">⚙️ Admin</h2>
            <p class="text-muted" style="font-size:12px; margin-bottom:20px;">Thosu Control Panel</p>
            <div id="nav-items" style="display:flex; flex-direction:column; gap:4px;"></div>
            <button id="logout-btn" class="danger" style="width:100%; margin-top:24px;">Logout</button>
        </nav>

        <!-- Main Content -->
        <main id="main-content" style="margin-left:220px; padding:24px; min-height:100vh;">
            <div id="panel-container"></div>
        </main>
    </div>
</DefaultLayout>
